        else:
            # Otherwise, check whether the value is a whole or decimal number.
            try:
                output = float(value) if "." in value else int(value)
            except ValueError:
                print("That example is not supported.")
                print('Try something like: print("Hello, World!") or print(25)')
                continue

        print("\n" + "-" * 10)
        print(color_text("OUTPUT:", Colors.GREEN))
        print(output)
        print("-" * 10)


    knowledge_check(
        "Which is the correct way to print text in Python?",
        ['print("Hello!")', "print(Hello!)", 'Print("Hello!")'],
        1,
        "The function name is lowercase print, and text needs quotation marks."
