def textwrap_text(text):
    """Wrap long descriptions so they are easier to read."""
    return textwrap.fill(text, width=65)


def lesson_7():
    lesson_open("7 - ARITHMETIC OPERATORS", "Use Python arithmetic operators to perform calculations and understand their results.")
    print("""
Arithmetic operators perform mathematical calculations.

+   Addition
-   Subtraction
*   Multiplication
/   Division
//  Floor division
%   Modulus (remainder)
**  Exponentiation (power)

An expression combines values and operators.

Example:
    first = 11
    second = 13
    result = first + second
    print(result)

Output:
    24

Python follows PEMDAS:
Parentheses, Exponents, Multiplication/Division,
and Addition/Subtraction.
""")

    while ask_yes_no("\nWould you like to try a calculation? (Y/N): "):
        try:
            first = float(input("Enter the first number: "))
            symbol = input("Choose an operator (+, -, *, /, //, %, **): ").strip()
            second = float(input("Enter the second number: "))

            if symbol == "+":
                result = first + second
            elif symbol == "-":
                result = first - second
            elif symbol == "*":
                result = first * second
            elif symbol == "/":
                if second == 0:
                    print("You cannot divide by zero.")
                    continue
                result = first / second
            elif symbol == "//":
                if second == 0:
                    print("You cannot divide by zero.")
                    continue
                result = first // second
            elif symbol == "%":
                if second == 0:
                    print("You cannot divide by zero.")
                    continue
                result = first % second
            elif symbol == "**":
                result = first ** second
            else:
                print("That operator is not on the list.")
                continue

            print("\nResult:", result)

        except ValueError:
            print("Please enter valid numbers.")


    knowledge_check(
        "Which operator finds the remainder after division?",
        ["%", "**", "//"],
        1,
        "The modulus operator (%) gives the remainder."
    )


