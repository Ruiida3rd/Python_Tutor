def lesson_3():
    lesson_open("3 - PRINTING OUTPUT", "Learn how print() displays text, numbers, and simple calculations on the screen.")
    print("""
THE print() FUNCTION
The print() function displays information on the screen.

Syntax:
    print(value)

Examples:
    print("Hello, World!")
    print(25)
    print(10 + 5)

Text needs quotation marks. Numbers do not.

PRACTICE
Type a simple print() statement, for example:
    print("Hello, World!")

For this activity, the tutorial accepts print() statements
containing simple text or number values only.
It does not run other Python commands.
""")

    while True:
        if not ask_yes_no("Would you like to try it? (Y/N): "):
            break

        code_text = input(
            '\nType your print() code (or E to leave): '
        ).strip()

        if code_text.lower() == "e":
            break

        # This activity accepts simple print() statements only.
        if not code_text.startswith("print(") or not code_text.endswith(")"):
            print("Please type a print() statement.")
            continue

        value = code_text[6:-1].strip()

        # If the value has quotation marks, display it as text.
        if (value.startswith('"') and value.endswith('"')) or (value.startswith("'") and value.endswith("'")):
