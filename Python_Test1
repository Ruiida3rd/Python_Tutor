LINE = "=" * 45


class Colors:
    """ANSI terminal colors. They turn off when output is not a terminal."""
    RESET = "\033[0m"
    BOLD = "\033[1m"
    CYAN = "\033[96m"
    BLUE = "\033[94m"
    MAGENTA = "\033[95m"
    GREEN = "\033[92m"
    YELLOW = "\033[93m"
    RED = "\033[91m"
    WHITE = "\033[97m"


# Keep output readable in terminals; avoid color codes in redirected output.
USE_COLOR = sys.stdout.isatty() and "NO_COLOR" not in os.environ


def color_text(text, color):
    if USE_COLOR:
        return f"{color}{text}{Colors.RESET}"
    return str(text)


def show_panel(title, message, color=Colors.CYAN):
    """Display a simple colored box around a title and message."""
    border = "+" + "-" * 45 + "+"

    print(color_text(border, color))
    print(color_text("| " + title.center(43) + " |", color))
    print(color_text(border, color))
    print(message)
    print(color_text(border, color))


def lesson_open(title, goal):
    show_title(title)
    show_panel("TODAY'S LEARNING GOAL", goal, Colors.BLUE)
    print(color_text("\nLESSON TIME!", Colors.YELLOW))
    print("  STEP 1: Read the explanation.")
    print("  STEP 2: Study the code example.")
    print("  STEP 3: Try the activity.")
    print("  STEP 4: Answer the quick knowledge check.")


def knowledge_check(question, options, correct, explanation):
    """A short multiple-choice check after a lesson."""
    print()
    show_panel("QUICK KNOWLEDGE CHECK", question, Colors.MAGENTA)
    for number, option in enumerate(options, start=1):
        print(color_text(f"  {number}. ", Colors.YELLOW) + option)

    answer = get_number("Your answer (1-3): ", 1, 3)
    if answer == correct:
        print(color_text("\n✓ CORRECT! Great job!", Colors.GREEN))
    else:
        print(color_text(f"\nNot quite. The correct answer is {correct}.", Colors.YELLOW))

    print(color_text("WHY? ", Colors.CYAN) + explanation)


def pause():
    """Wait until the user is ready to continue."""
    input("\nPress Enter to continue...")


def ask_yes_no(question):
    """Ask a question until the user enters Y or N."""
    while True:
        answer = input(question).strip().lower()

        if answer in ("y", "yes"):
            return True
        if answer in ("n", "no"):
            return False

        print(color_text("Please enter Y or N.", Colors.RED))


def get_number(prompt, minimum=None, maximum=None):
    """Get a whole number and keep asking if the input is invalid."""
    while True:
        try:
            number = int(input(prompt))

            if minimum is not None and number < minimum:
                print(color_text(f"Please enter a number that is at least {minimum}.", Colors.YELLOW))
                continue

            if maximum is not None and number > maximum:
                print(color_text(f"Please enter a number no greater than {maximum}.", Colors.YELLOW))
                continue

            return number

        except ValueError:
            print(color_text("Invalid input. Please enter a whole number.", Colors.RED))


def show_title(title):
    print()
    print(color_text(LINE, Colors.CYAN))
    print(color_text(title.center(45), Colors.BOLD + Colors.MAGENTA))
    print(color_text(LINE, Colors.CYAN))


